# Copy this file to .env next to docker-compose.yml on the VPS and change every value.
# Docker Compose reads .env automatically (Docker Inc., 2026e). Never commit the real .env file.

IMAGE_TAG=v3.0
GATEWAY_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=60

ADMIN_EMAIL=admin@coffeenchill.ac.za
ADMIN_PASSWORD=replace-with-a-strong-password-1A
