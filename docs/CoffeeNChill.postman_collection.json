				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"adminToken\", jsonData.token);",
									"",
									"pm.test(\"Token is returned for the Admin role\", function () {",
									"    pm.expect(jsonData.token).to.be.a('string').and.not.be.empty;",
									"    pm.expect(jsonData.role).to.eql(\"Admin\");",
									"});",
									"",
									"pm.test(\"JWT contains the Name, Email and Role claims\", function () {",
									"    let payload = jsonData.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
									"    while (payload.length % 4) { payload += '='; }",
									"    const claims = JSON.parse(atob(payload));",
									"    pm.expect(claims[\"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name\"]).to.eql(\"Canteen Manager\");",
									"    pm.expect(claims[\"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress\"]).to.eql(pm.collectionVariables.get(\"adminEmail\"));",
									"    pm.expect(claims[\"http://schemas.microsoft.com/ws/2008/06/identity/claims/role\"]).to.eql(\"Admin\");",
									"});"
								]
							}
						}
					],
